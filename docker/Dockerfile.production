# syntax=docker/dockerfile:1

FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        ca-certificates \
        curl \
        unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Layer caching: install dependencies first (without project)
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=secret,id=uv_index_username \
    --mount=type=secret,id=uv_index_password \
    UV_INDEX_GITEA_USERNAME="$(cat /run/secrets/uv_index_username)" \
    UV_INDEX_GITEA_PASSWORD="$(cat /run/secrets/uv_index_password)" \
    uv sync --frozen --no-dev --no-install-project

# Copy source code
COPY main.py ./
COPY src/ src/

# Copy entrypoint (runs migrations before starting the app)
COPY docker/entrypoint.sh docker/entrypoint.sh
RUN chmod +x docker/entrypoint.sh

# Install the project itself
RUN --mount=type=secret,id=uv_index_username \
    --mount=type=secret,id=uv_index_password \
    UV_INDEX_GITEA_USERNAME="$(cat /run/secrets/uv_index_username)" \
    UV_INDEX_GITEA_PASSWORD="$(cat /run/secrets/uv_index_password)" \
    uv sync --frozen --no-dev

EXPOSE 8000

CMD ["/app/docker/entrypoint.sh"]
