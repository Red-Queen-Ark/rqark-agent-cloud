PROJECT_NAME=rqark-agent-cloud

REDIS_SERVER=localhost
REDIS_PORT=6379

# Data cloud
DATA_CLOUD_URL=http://localhost:7302

# Tasks
# Must match INTERNAL_TOKEN in rqark-data-cloud: the claim and finalize
# endpoints are guarded by it.
INTERNAL_TOKEN=0a3be1ef5e090053bf78701be8c0fefdc955e5e878d26eed3ed1e26a0f5e9080
TASK_RUN_TIMEOUT=600
TASKS_ENABLED=true
TASK_TICK_SECONDS=30
TASK_CONCURRENCY=1

# ASR
# engine: qwen3 (Apple Silicon via mlx-audio) or faster-whisper. Empty picks by platform.
ASR_ENGINE=
ASR_MODEL=
ASR_MODEL_DIR=
ASR_LANGUAGE=Cantonese
ASR_MAX_BYTES=26214400
ASR_MAX_SECONDS=60
ASR_TIMEOUT=60
ASR_QUEUE_TIMEOUT=30
ASR_CONCURRENCY=1
ASR_OPENCC=true
ASR_OPENCC_CONFIG=s2hk

# Voice
VOICE_MAX_SECONDS=60
VOICE_MAX_CONNECTIONS=4
VOICE_MAX_PER_USER=1
VOICE_IDLE_TIMEOUT=300
VOICE_VAD_THRESHOLD=0.5
VOICE_VAD_SILENCE_MS=1000
VOICE_VAD_LEAD_MS=250
VOICE_VAD_MIN_MS=250
# 空 = 用 package 內置 src/apps/voice/models/wednesday.onnx；逗號分隔可填多個 model
VOICE_WAKE_MODEL=wednesday,diana
VOICE_WAKE_THRESHOLD=0.5
